<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="Orelle — Stack your day" suffix=" · Orelle">
      {assigns[:page_title]}
    </.live_title>
    <meta name="description" content="Stack your day. Kanban boards with smart lists for Today, Upcoming, Anytime, and Waiting." />

    <%!-- PWA manifest: declares Orelle as an installable web app to iOS and Android. --%>
    <link rel="manifest" href={~p"/manifest.webmanifest"} />

    <%!-- iOS-specific PWA tags. When the user does "Add to Home Screen", these tell iOS to:
         * launch full-screen (no Safari chrome) — `apple-mobile-web-app-capable=yes`
         * show a dark status bar that blends with the app — `black-translucent`
         * display "Orelle" as the icon label — `apple-mobile-web-app-title`
         * use this icon (180×180 is the modern iOS standard) --%>
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Orelle" />
    <link rel="apple-touch-icon" href={~p"/icons/apple-touch-icon.png"} />

    <%!-- Status-bar / address-bar tint on Chrome / supported browsers. --%>
    <meta name="theme-color" content="#4f46e5" />

    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <%!-- esbuild emits a sibling CSS file when JS imports stylesheets (e.g. cropper.min.css). --%>
    <link phx-track-static rel="stylesheet" href={~p"/assets/js/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const setTheme = (theme) => {
          document.documentElement.setAttribute("data-theme-pref", theme);
          if (theme === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.removeAttribute("data-theme");
          } else {
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));
      })();
    </script>
  </head>
  <body>
    {@inner_content}
  </body>
</html>
